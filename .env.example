# =============================================================================
# Mata Labs Hiring — Environment Variables
# Copy this file to `.env.local` and fill in values.
# =============================================================================

# --- Google Sheets via Apps Script webhook ---
# Deploy doPost from the sheet (Extensions → Apps Script). See docs/GOOGLE_SHEETS_SETUP.md
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec
# Optional shared secret (must match SECRET in the Apps Script)
# GOOGLE_SHEETS_WEBHOOK_SECRET=

# --- Rate limiting (optional overrides) ---
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW_MS=900000

# --- App ---
# NEXT_PUBLIC_APP_NAME=Mata Labs
